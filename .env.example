# LibreLMS-rustedition environment template.
# Copy to .env and fill in real values; never commit .env.

# Local full-environment service password (docker-compose; never committed as .env)
MSSQL_SA_PASSWORD=CHANGE_ME

# MSSQL system of record (Principle VI)
DATABASE_URL=mssql://sa:CHANGE_ME@localhost:1433/LibreLms?encrypt=disable

# Valkey (Redis-protocol) — ephemeral SCORM session bag only
VALKEY_URL=redis://localhost:6379

# HTTP
PORT=5000
